<% layout("/layouts/boilerplate") %>
<!-- <script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
</script> -->
    <div class="row">
        <div class="col-8 offset-3 mt-3">
    <h3><%= data1.title %></h3>
    </div>
    <div class="card col-6 offset-3 listening-card">
        <img src="<%= data1.image.url %>" class="card-img-top show-img mt-3" alt="listening_image_URL">
  <div class="card-body">
    <p class="card-text">
        <i>Owned by <%= data1.owner.username %></i>
        <br>
        <%= data1.description %> <br>
        <b>&#x20B9;<%= data1.price %>/night</b><br>
        <%= data1.location %> <br>
        <%= data1.country %>
        
        <% if (curruser && curruser._id.equals(data1.owner._id)) { %>
         <form action="/listening/<%= data1._id %>?_method=DELETE" method="POST">
                <button class="btn btn-danger mt-2 btn1">Delete Listening</button>
            </form>
        <% } %>

    </p>
    </div>
    </div>
    <hr>
   <div class="row">
     <div class="col-8 offset-3 mt-3">
        <% if (curruser) { %>
        <h4>leave a review</h4>
        <form action="/listening/<%= data1.id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
           <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>    
            <div  class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea 
                name="review[comment]"
                 id="comment"
                  cols="30"
                   rows="5" 
                   class="form-control"
                   required
                   ></textarea>
                   <div class="invalid-feedback">Please add some comments</div>
            </div>
            
             <button class="btn btn-outline-dark">Submit</button>
        <hr>
            <% } %>
        </form>
        
        <% if(data1.reviews && data1.reviews.length > 0) { %>
        <div class="row">
            <p><b><b>All reviews</b></b></p>
         <% for(let data2 of data1.reviews) { %>
            <div class="card col-5 mb-3 ms-3 mt-2">
                    <div class="card-body">
                        <h5 class="card-title">@<%= data2.author.username %> </h5>
                         <p class="starability-result card-text" data-rating="<%= data2.rating %>"></p>
                       <i><p class="card-text"><%= data2.comment %></p></i>
                        <!-- <b><p class="card-text"><%= data2.rating %> *</p></b> -->
                    </div>
                    <form class="mb-3 mt-2" method="POST" action="/listening/<%= data1._id %>/review/<%= data2._id%>?_method=DELETE">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
            </div>       
        <% } %>
        </div>
         <% } %>
    </div>
    <div class="col-8 offset-3 mt-3">
            <h3>Where you'll be</h3>
            <div id="map"></div>
    </div>
   </div>
   </div>
</div>
