<% layout("/layouts/boilerplate") %>
<style>
 #filters{
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  align-items: center;
  padding-bottom: 10px;
  }
  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.5;
  }
  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }
  .tax-info{
    display: none;
  }
  .tax-toggle{
    border: 1px solid black;
    border-radius: 1rem;
    height: 3rem;
    padding: 1rem;
    margin-left: 3.5rem;
    display: flex;
    align-items: center;
  }
</style>
    <div id="filters" class="d-flex flex-wrap justify-content-center gap-3 mt-3">
      <a href="/listening/filter/trending">
        <div class="filter text-center filter-link">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <i class="fa-solid fa-bed"></i>
          <p>Room</p>
        </div>
      </a>
       <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>Iconic Cities</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>Castles</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-solid fa-campground"></i></div>
          <p>Campaign</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-solid fa-cow"></i></div>
          <p>Farms</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-solid fa-snowflake"></i></div>
          <p>Arctic</p>
        </div>
      </a>
      <a href="/listening/filter/trending">
        <div class="filter text-center">
          <div><i class="fa-solid fa-water"></i></div>
          <p>Sea</p>
        </div>
      </a>
      <div class="dark_mode">
         <div class="form-check-reverse form-switch"></div>
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Switch to dark mode</label>
      </div>
      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
</div>
      </div>
    </div>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% for(let list of allistening){%>
          <a href="/listening/<%= list.id %>" class="listening-link">
    <div class="card listening-card h-100">
  <img src="<%= list.image.url %>" class="card-img-top" alt="listening_image" style="height:20rem; object-fit:cover;">
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
     <b><%= list.title %></b> <br>
    &#x20B9; <%= list.price %> /night
    <i class="tax-info"> &nbsp;+ 18% GST</i>
    </p>
  </div>
 </div>
</a>
 <% } %>
    </div>
<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", ()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    
    for(info of taxInfo){
      if(info.style.display != "inline"){
          info.style.display = "inline";
      }else{
        info.style.display = "none";
      }
    }
  })
</script>

