<% layout("/layouts/boilerplate") %>
<div class="signup p-4 mt-5 shadow col-6 offset-3"style="border-radius: 15px; backdrop-filter: blur(10px);">
<h1 class="col-6 offset-3">Signup Page</h1>
<hr>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
           <label for="username" class="form-label"><b>Username</b></label>
           <input
            type="text" 
            placeholder="Enter Username"
            name="username"
            id="username";
            class="form-control" 
            required>
           <div class="valid-feedback">Looks good</div>
           <div class="invalid-feedback">Enter valid title</div>
        </div>
        <div class="mb-3">
           <label for="email" class="form-label"><b>email</b></label>
           <input
            type="email" 
            placeholder="Enter valid email"
            name="email"
            id="email";
            class="form-control" 
            required>
           <div class="valid-feedback">Looks good</div>
           <div class="invalid-feedback">Enter valid email</div>
        </div>
        <div class="mb-3">
           <label for="password" class="form-label"><b>Password</b></label>
           <input
            type="password" 
            placeholder="Enter a strong password"
            name="password"
            id="password";
            class="form-control" 
            required>
            <div class="valid-feedback">Looks good</div>
           <div class="invalid-feedback">Enter a password</div>
        </div>
        <button class="btn btn-success">Signup</button>
        </form>
    </div>
</div>
</div>