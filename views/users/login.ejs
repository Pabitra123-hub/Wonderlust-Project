<% layout("/layouts/boilerplate") %>
<div class="login-border p-4 mt-5 shadow col-6 offset-3"style="border-radius: 15px; backdrop-filter: blur(10px);">
    <h1 class="col-6 offset-3">Login</h1>
    <div class="row mt-3">
    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
           <label for="username" class="form-label"><b>Username</b></label>
           <input
            type="text" 
            placeholder="Enter Username"
            name="username"
            id="username";
            class="form-control" 
            required>
        </div>
        <div class="mb-3">
           <label for="password" class="form-label"><b>Password</b></label>
           <input
            type="password" 
            placeholder="Enter a strong password"
            name="password"
            id="password"
            class="form-control" 
            required>
        </div>
        <button class="btn btn-success mb-4">Login</button>
        <br>
        </form>
    </div>
</div>
</div>